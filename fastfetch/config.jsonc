{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {
      "1": "38;2;155;93;229",
      "2": "38;2;241;91;181"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;155;93;229",
      "title": "38;2;241;91;181",
      "separator": "38;2;108;108;138"
    },
    "key": {
      "width": 16
    },
    "percent": {
      "type": 3
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "■"
      },
      "width": 12
    },
    "size": {
      "binaryPrefix": "iec"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{#1}{#38;2;241;91;181}{user-name}{#38;2;108;108;138}@{#1}{#38;2;155;93;229}{host-name}"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;241;91;181}╭─ {#1}{#38;2;241;91;181}system{#}"
    },
    {
      "type": "os",
      "key": "│   os"
    },
    {
      "type": "kernel",
      "key": "│   kernel"
    },
    {
      "type": "packages",
      "key": "│ 󰏗  packages"
    },
    {
      "type": "uptime",
      "key": "│   uptime"
    },
    {
      "type": "wm",
      "key": "│   wm"
    },
    {
      "type": "shell",
      "key": "│   shell"
    },
    {
      "type": "terminal",
      "key": "│   terminal"
    },
    {
      "type": "terminalfont",
      "key": "│   font"
    },
    {
      "type": "custom",
      "format": "{#38;2;241;91;181}╰─{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;241;91;181}╭─ {#1}{#38;2;241;91;181}hardware{#}"
    },
    {
      "type": "host",
      "key": "│ 󰌢  model"
    },
    {
      "type": "cpu",
      "key": "│   cpu",
      "temp": true
    },
    {
      "type": "gpu",
      "key": "│ 󰢮  gpu",
      "temp": true
    },
    {
      "type": "display",
      "key": "│   display"
    },
    {
      "type": "memory",
      "key": "│ 󰍛  memory"
    },
    {
      "type": "swap",
      "key": "│ 󰓡  swap"
    },
    {
      "type": "disk",
      "key": "│   disk",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "│   battery"
    },
    {
      "type": "poweradapter",
      "key": "│   power"
    },
    {
      "type": "custom",
      "format": "{#38;2;241;91;181}╰─{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;241;91;181}╭─ {#1}{#38;2;241;91;181}extras{#}"
    },
    {
      "type": "wifi",
      "key": "│   wifi"
    },
    {
      "type": "localip",
      "key": "│   local ip",
      "showIpv4": true,
      "compact": true
    },
    {
      "type": "media",
      "key": "│   playing"
    },
    {
      "type": "locale",
      "key": "│   locale"
    },
    {
      "type": "custom",
      "format": "{#38;2;241;91;181}╰─{#}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
