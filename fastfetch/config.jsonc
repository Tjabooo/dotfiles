// ~/.config/fastfetch/config.jsonc  —  EVA unit-01 (violet armour, fluorescent green)
// One file, one logo (unit01.txt). Run plain `fastfetch`.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/unit01.txt",
    "color": { "1": "38;2;155;93;229", "2": "38;2;158;240;26" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": " ",
    "key": { "width": 8 },
    "color": { "keys": "38;2;155;93;229", "output": "38;2;224;224;240" },
    "percent": {
      "type": ["num"],
      "color": { "green": "38;2;158;240;26", "yellow": "38;2;255;195;113", "red": "38;2;255;82;82" }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#1;38;2;158;240;26}初号機 {#0;38;2;224;224;240}{user-name}{#38;2;108;108;138}@{#38;2;155;93;229}{host-name}"
    },
    { "type": "custom", "format": "{#38;2;108;108;138}EVANGELION TEST TYPE-01" },
    "break",
    { "type": "os",       "key": "OS",     "format": "{name}" },
    { "type": "kernel",   "key": "KERNEL", "format": "{release}" },
    { "type": "wm",       "key": "WM",     "format": "{pretty-name}" },
    { "type": "uptime",   "key": "ACTIVE" },
    { "type": "memory",   "key": "LCL",    "format": "{used} / {total} · {percentage}" },
    { "type": "battery",  "key": "POWER",  "format": "{capacity} · {status}" }
  ]
}
