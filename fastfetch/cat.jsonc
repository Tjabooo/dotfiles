// ~/.config/fastfetch/cat.jsonc  —  midnight-neon cat (based on m3tozz/FastCat)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/cat.txt",
    "color": {
      "1": "38;2;155;93;229",
      "2": "38;2;241;91;181"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 5
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "output": "38;2;186;187;241",
      "separator": "38;2;108;108;138"
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;186;187;241",
        "yellow": "38;2;255;195;113",
        "red": "38;2;255;82;82"
      }
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "■"
      },
      "width": 10,
      "color": {
        "elapsed": "38;2;241;91;181",
        "total": "38;2;108;108;138"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#1}{#38;2;241;91;181}{user-name}{#38;2;108;108;138} @ {#1}{#38;2;155;93;229}{host-name}"
    },
    {
      "type": "custom",
      "format": "{#38;2;108;108;138}──────────────────────{#}"
    },
    {
      "type": "os",
      "key": " ",
      "keyColor": "38;2;155;93;229"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "38;2;155;93;229"
    },
    {
      "type": "packages",
      "key": "󰏗 ",
      "keyColor": "38;2;155;93;229"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "38;2;155;93;229"
    },
    {
      "type": "memory",
      "key": "󰍛 ",
      "keyColor": "38;2;241;91;181"
    },
    {
      "type": "battery",
      "key": " ",
      "keyColor": "38;2;241;91;181"
    },
    {
      "type": "media",
      "key": " ",
      "keyColor": "38;2;241;91;181"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
