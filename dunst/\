[global]
    monitor = 0
    follow = mouse
    geometry = "400x50-20+60"
    origin = top-right
    offset = 28x20
    shrink = yes
    transparency = 0
    frame_color = "#9b5de5"
    frame_width = 2
    separator_height = 2
    separator_color = auto
    padding = 12
    horizontal_padding = 16
    text_icon_padding = 8
    line_height = 0
    markup = full
    format = "<b>%s</b>\n<span foreground='#e0e0f0'>%b</span>"
    sort = yes
    indicate_hidden = yes
    word_wrap = yes
    ignore_newline = no
    show_indicators = no
    min_icon_size = 32
    max_icon_size = 64
    browser = firefox
    icon_position = left
    sticky_history = yes
    history_length = 20
    mouse_left_click = close_current
    mouse_right_click = close_all
    mouse_middle_click = do_action

[urgency_low]
    background = "#1a1a2f"
    foreground = "#e0e0f0"
    frame_color = "#444"
    timeout = 4

[urgency_normal]
    background = "#0f0f1e"
    foreground = "#e0e0f0"
    frame_color = "#9b5de5"
    timeout = 8

[urgency_critical]
    background = "#0f0f1e"
    foreground = "#ffffff"
    frame_color = "#ff5252"
    timeout = 0
