{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Folder }}",
  "palette": {
    "base": "#0f0f1e",
    "surface": "#1a1a2f",
    "overlay": "#2a2a45",
    "text": "#e0e0f0",
    "muted": "#6c6c8a",
    "violet": "#9b5de5",
    "pink": "#f15bb5",
    "lavender": "#babbf1",
    "cyan": "#00c6ff",
    "green": "#81c784",
    "amber": "#ffc371",
    "red": "#ff5252"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "p:violet",
          "foreground": "#ffffff",
          "template": " {{ .Icon }} "
        },
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "p:surface",
          "foreground": "p:lavender",
          "template": "  {{ .Path }} ",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3,
            "home_icon": "~",
            "folder_separator_icon": "  "
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "p:overlay",
          "foreground": "p:text",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} ",
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "branch_icon": " "
          },
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:pink{{ end }}",
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}p:violet{{ end }}"
          ],
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:base{{ end }}",
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}#ffffff{{ end }}"
          ]
        },
        {
          "type": "python",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "p:surface",
          "foreground": "p:cyan",
          "template": "  {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Major }}.{{ .Minor }} ",
          "properties": {
            "fetch_virtual_env": true,
            "display_mode": "context"
          }
        },
        {
          "type": "node",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "p:surface",
          "foreground": "p:green",
          "template": "  {{ .Major }}.{{ .Minor }} ",
          "properties": {
            "display_mode": "files"
          }
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:amber",
          "template": " {{ .FormattedMs }} ",
          "properties": {
            "threshold": 2000,
            "style": "austin"
          }
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:red",
          "template": "{{ if gt .Code 0 }} {{ .Code }} {{ end }}",
          "properties": {
            "always_enabled": true
          }
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:muted",
          "template": " {{ .CurrentDate | date .Format }}",
          "properties": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:violet",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "template": "❯"
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "p:violet",
    "foreground_templates": [
      "{{ if gt .Code 0 }}p:red{{ end }}"
    ],
    "template": "❯ "
  },
  "secondary_prompt": {
    "foreground": "p:pink",
    "template": "❯❯ "
  }
}
