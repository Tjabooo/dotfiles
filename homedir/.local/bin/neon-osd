#!/bin/bash
# neon-osd: volume / mic / brightness keys with an on-screen bar (a dunst notification that
# replaces itself instead of stacking).
#
#   neon-osd vol up|down|mute     neon-osd mic mute     neon-osd light up|down
note() { notify-send -a neon-osd -t 1200 -h string:x-dunst-stack-tag:neon-osd "$@"; }

case "$1 $2" in
  "vol up")   wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
  "vol down") wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
  "vol mute") wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  "mic mute")
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
      note -i microphone-sensitivity-muted "Microphone muted"
    else
      note -i microphone-sensitivity-high "Microphone on"
    fi
    exit ;;
  "light up")   brightnessctl -q set 5%+ ;;
  "light down") brightnessctl -q --min-value=1% set 5%- ;;   # -n: never all the way to black
  *) echo "usage: neon-osd vol up|down|mute | mic mute | light up|down" >&2; exit 2 ;;
esac

if [[ $1 == vol ]]; then
  read -r _ v m < <(wpctl get-volume @DEFAULT_AUDIO_SINK@)
  pct=$(awk -v v="$v" 'BEGIN { printf "%d", v * 100 + 0.5 }')
  if [[ $m == *MUTED* ]]; then
    note -i audio-volume-muted -h int:value:"$pct" "Muted"
  else
    icon=audio-volume-high; (( pct < 66 )) && icon=audio-volume-medium; (( pct < 33 )) && icon=audio-volume-low
    note -i "$icon" -h int:value:"$pct" "Volume ${pct} %"
  fi
else
  pct=$(( $(brightnessctl get) * 100 / $(brightnessctl max) ))
  note -i display-brightness -h int:value:"$pct" "Brightness ${pct} %"
fi
