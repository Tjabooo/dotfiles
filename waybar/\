{
	"layer": "top",
	"modules-left": ["custom/launcher","cpu","custom/memory", "custom/media", "custom/spotify",],
	"modules-center": ["river/tags", "wlr/workspaces", "custom/clock"],
	"modules-right": ["custom/updates", "backlight","pulseaudio", "hyprland/language", "network", "battery"],
        "margin-top": 10,
        "margin-left": 10,
        "margin-right": 10,

	"pulseaudio": {
		"tooltip": false,
		"scroll-step": 5,
		"format": "<span class='icon'>{icon}</span> <span class='text'>{volume}%</span>",
		"format-muted": "<span class='icon'>{icon}</span> <span class='text'>{volume}%</span>",
		"on-click":"pactl set-sink-mute @DEFAULT_SINK@ toggle",
		"format-icons": {
			"default": ["", "", " "]
		}
	},
    "river/tags": {
		"num-tags": 6
    },
	"network": {
		"tooltip": false,
		"format-wifi": "<span class='icon'> </span> <span class='text'>{essid}</span>",
		"format-ethernet": ""
	},
	"backlight": {
		"tooltip": false,
		"format": "<span class='icon'></span> <span class='text'>{}%</span>",
		"interval":1,
        "on-scroll-up": "light -A 5",
		"on-scroll-down": "light -U 5"
	},
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "<span class='icon'>{icon}</span>  <span class='text'>{capacity}%</span>",
        "format-charging": "<span class='icon'></span> <span class='text'>{capacity}%</span>",
        "format-plugged": "<span class='icon'></span> <span class='text'>{capacity}%</span>",
        "format-alt": "<span class='text'>{time}</span> <span class='icon>{icon}</span>",
        "format-icons": ["", "", "", "", ""]
    },
	"tray":{
		"icon-size":18,
		"spacing": 10,
	},
    "wlr/workspaces": {
        "format": "{icon}",
        "format-active": " {icon} ",
        "on-click": "activate"
        // "format-icons":{
        //     "10":"10"
        // }
    },
    "custom/clock": {
        "exec": "date +'<span class='icon'></span> <span class='text'>%D</span> <span class='icon'></span> <span class='text'>%H:%M:%S</span>'",
        "interval": 1
    },
    "hyprland/language": {
        "min-length": 8,
        "format": "  {}",
        "format-en": "US",
        "format-sv": "SE",
        "keyboard-name": "at-translated-set-2-keyboard",
        "interval": 1
    },
    "cpu": {
        "interval": 1,
        "format": " {}%",
        "max-length": 10
    },
    "custom/memory": {
        "interval": 5,
        "exec": "~/.config/hypr/scripts/memory.sh",
        "format": " {text}",
    },
    "custom/spotify": {
        "exec": "playerctl --player=spotify,youtube,netflix metadata --format '{{artist}} - {{title}}'",
        "format": "  {}",
        "interval": 1,
        "on-click": "playerctl --player=spotify,youtube,netflix play-pause",
        "on-scroll-up": "playerctl --player=spotify,youtube,netflix next",
        "on-scroll-down": "playerctl --player=spotify,youtube,netflix previous"
    },
    "custom/media": {
        "interval": 30,
        "format": "{icon} {}",
        "return-type": "json",
        "max-length": 20,
        "format-icons": {
            "spotify": " ",
            "default": " "
        },
        "escape": true,
        "exec": "$HOME/.config/system_scripts/mediaplayer.py 2> /dev/null",
        "on-click": "playerctl play-pause"
    },
    "custom/launcher":{
        "format": " ",
        "on-click": "wofi",
        "on-click-right": "killall wofi"
    },
    "custom/power":{
        "format": " ",
        "on-click": "bash ~/.config/rofi/leave/leave.sh",
    },
    "custom/updates":{
        "format": "{} Update(s)",
        "exec": "checkupdates | wc -l",
        "exec-if": "[[ $(checkupdates | wc -l) != 0 ]]",
        "interval": 15,
        "on-click": "alacritty -e pacman -Syu && notify-send 'The system has been updated' "
    },
    "custom/wallpaper":{
        "format":" ",
        "on-click": "bash ~/.config/system_scripts/pkill_bc"
    }
}
