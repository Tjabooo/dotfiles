w:q* {
    border: none;
    border-radius: 12px;
    font-family: "JetBrainsMono Nerd Font", "Material Design Icons", "Font Awesome 6 Free", "Noto Sans", sans-serif;
    font-size: 14px;
    min-height: 20px;
    margin-left: 4px;
    margin-right: 6px;
}

window#waybar {
    background: #0f0f1e;
    border-radius: 16px;
    padding: 6px 10px;
    transition: all 200ms ease-in-out;
    box-shadow: 0 0 10px rgba(20, 20, 40, 0.6);
}

window#waybar.hidden {
    opacity: 0.2;
}

#workspaces button,
#tags button,
#network,
#pulseaudio,
#language,
#battery,
#backlight,
#custom-clock,
#custom-memory,
#custom-spotify,
#cpu,
#tray,
#custom-launcher,
#custom-power,
#custom-wallpaper,
#custom-updates,
#custom-media {
    padding: 4px 10px;
    margin: 4px 6px;
    border-radius: 10px;
    color: #e0e0f0;
    background: rgba(255, 255, 255, 0.07);
    transition: background 200ms ease, box-shadow 200ms ease, padding 150ms ease;
}

#custom-memory {
    background-image: url("/home/tjabo/.config/waybar/memory/png");
    background-size: contain;
    background-repeat: no-repeat;
    background-position: left center;
}

#workspaces button:hover,
#tags button:hover,
#network:hover,
#pulseaudio:hover,
#language:hover,
#battery:hover,
#backlight:hover,
#custom-clock:hover,
#custom-memory:hover,
#custom-spotify:hover,
#cpu:hover,
#tray:hover,
#custom-launcher:hover,
#custom-power:hover,
#custom-wallpaper:hover,
#custom-updates:hover,
#custom-media:hover {
    background: rgba(200, 180, 255, 0.15);
    box-shadow: 0 0 6px rgba(160, 130, 255, 0.4);
}

#workspaces button.active {
    background: linear-gradient(135deg, #9b5de5, #f15bb5);
    color: #ffffff;
    font-weight: bold;
    box-shadow: 0 0 8px rgba(240, 150, 255, 0.6);
}

#pulseaudio.muted {
    background: linear-gradient(135deg, #ff1744, #ff5252);
    color: #ffffff;
    font-weight: bold;
    box-shadow: 0 0 6px rgba(255, 50, 50, 0.8);
}

@keyframes pulseMute {
    from { box-shadow: 0 0 6px rgba(255, 50, 50, 0.5); }
    to { box-shadow: 0 0 8px rgba(255, 0, 0, 0.9); }
}

#battery.charging,
#battery.plugged {
    background: linear-gradient(135deg, #4caf50, #81c784);
    color: #fff;
    box-shadow: 0 0 6px rgba(100, 255, 100, 0.5);
}

#battery.critical:not(.charging) {
    background: linear-gradient(135deg, #ff5252, #ff1744);
    color: #fff;
    animation: blink 0.8s infinite alternate;
    box-shadow: 0 0 8px rgba(255, 70, 70, 0.6);
}

@keyframes blink {
    from { opacity: 1; }
    to { opacity: 0.5; }
}

#custom-launcher {
    font-size: 20px;
    color: #ffffff;
    background: linear-gradient(135deg, #00c6ff, #0072ff);
    padding: 5px 5px 5px 10px;
}

#custom-power {
    font-size: 18px;
    color: #fff;
    background: linear-gradient(135deg, #ff5f6d, #ffc371);
    box-shadow: 0 0 6px rgba(255, 120, 100, 0.5);
}

#pulseaudio .icon {
    color: #9b5de5;
}

#pulseaudio .text {
    color: #e0e0f0;
}

#network .icon {
    color: #9b5de5;
}

#network .text {
    color: #e0e0f0;
}

#backlight .icon {
    color: #9b5de5;
}

#backlight .text {
    color: #e0e0f0;
}

#custom-clock .icon {
    color: #9b5de5;
}

#custom-clock .text {
    color: #e0e0f0;
}

#language .icon {
    color: #9b5de5;
}

#language .text {
    color: #e0e0f0;
}

#cpu .icon {
    color: #9b5de5;
}

#cpu .text {
    color: #e0e0f0;
}

#custom-memory .icon {
    color: #9b5de5;
}

#custom-memory .text {
    color: #e0e0f0;
}

#custom-spotify .icon {
    color: #9b5de5;
}

#custom-spotify .text {
