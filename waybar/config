// ~/.config/waybar/config  —  floating "islands" layout
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 0,
  "reload_style_on_change": true,

  "modules-left":   ["custom/launcher", "hyprland/workspaces", "mpris"],
  "modules-center": ["clock"],
  "modules-right":  ["custom/updates", "custom/house", "tray", "custom/awake", "group/stats",
                     "backlight", "pulseaudio", "hyprland/language", "network",
                     "battery", "custom/power"],

  "custom/launcher": {
    "format": "",
    "tooltip": false,
    "on-click": "rofi -show drun",
    "on-click-right": "pkill rofi"
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "show-special": true,
    "persistent-workspaces": { "*": 5 },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  "mpris": {
    "format": "<span color='#9b5de5'>{player_icon}</span>  {dynamic}",
    "format-paused": "<span color='#6c6c8a'>{status_icon}</span>  <i>{dynamic}</i>",
    "dynamic-order": ["title", "artist"],
    "dynamic-len": 32,
    "player-icons": { "default": "󰎆", "spotify": "", "firefox": "" },
    "status-icons": { "paused": "" },
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "clock": {
    "format": "<span color='#9b5de5'></span>  {:%H:%M}",
    "format-alt": "<span color='#9b5de5'></span>  {:%a %d %b  %H:%M:%S}",
    "interval": 1,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "months":   "<span color='#babbf1'><b>{}</b></span>",
        "weeks":    "<span color='#6c6c8a'>W{}</span>",
        "weekdays": "<span color='#9b5de5'><b>{}</b></span>",
        "today":    "<span color='#f15bb5'><b><u>{}</u></b></span>"
      }
    }
  },

  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",   // cached + locked; needs pacman-contrib
    "format": "<span color='#f15bb5'>󰚰</span>  {}",
    "interval": 1800,
    "signal": 8,
    "tooltip": false,
    "on-click": "alacritty -e sh -c '~/.local/bin/neon-update; printf \"\\npress Enter to close \"; read _'"
  },

  // home server health (Marquee's House tab): hidden away from home and until marquee-house is installed
  "custom/house": {
    "exec": "~/.local/bin/marquee-house status",
    "exec-if": "test -x ~/.local/bin/marquee-house",
    "return-type": "json",
    "interval": 300,
    "signal": 9,
    "tooltip": true
  },

  "tray": { "icon-size": 16, "spacing": 10 },

  "custom/awake": {
    "exec": "~/.local/bin/screen-awake status",
    "return-type": "json",
    "interval": 2,
    "on-click": "~/.local/bin/screen-awake toggle",
    "exec-on-event": true,
    "tooltip": true
  },

  "group/stats": {
    "orientation": "inherit",
    "drawer": { "transition-duration": 300, "transition-left-to-right": false },
    "modules": ["cpu", "memory"]
  },
  "cpu":    { "interval": 2, "format": "<span color='#9b5de5'></span>  {usage}%" },
  "memory": {
    "interval": 5,
    "format": "<span color='#9b5de5'>󰍛</span>  {used:0.1f}G",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G used"
  },

  "backlight": {
    "format": "<span color='#9b5de5'></span>  {percent}%",
    "tooltip": false,
    "on-scroll-up": "brightnessctl -q set 5%+",
    "on-scroll-down": "brightnessctl -q --min-value=1% set 5%-"
  },

  "pulseaudio": {
    "format": "<span color='#9b5de5'>{icon}</span>  {volume}%",
    "format-muted": "<span color='#ff5252'>󰝟</span>  muted",
    "format-icons": { "default": ["", "", ""] },
    "scroll-step": 5,
    "tooltip": false,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },

  "hyprland/language": {
    "format": "<span color='#9b5de5'></span>  {}",
    "format-en": "US",
    "format-sv": "SE",
    "keyboard-name": "at-translated-set-2-keyboard"
  },

  "network": {
    "format-wifi": "<span color='#9b5de5'></span>  {essid}",
    "format-ethernet": "<span color='#9b5de5'>󰈀</span>  wired",
    "format-disconnected": "<span color='#ff5252'>󰤭</span>  offline",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "max-length": 22
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "<span color='#9b5de5'>{icon}</span>  {capacity}%",
    "format-charging": "<span color='#81c784'>󰂄</span>  {capacity}%",
    "format-plugged": "<span color='#81c784'></span>  {capacity}%",
    "format-alt": "<span color='#9b5de5'>{icon}</span>  {time}",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo}  ·  {power:0.1f}W"
  },

  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/power-menu.sh"
  }
}
