// ~/.config/waybar/config  —  "deck" islands: square panels, violet top bar, small uppercase tags;
// the same look as the eww overlays (neon/eww) and rofi (rofi/deck.rasi)
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 0,
  "reload_style_on_change": true,

  "modules-left":   ["custom/launcher", "hyprland/workspaces", "mpris"],
  "modules-center": ["clock", "custom/date"],
  "modules-right":  ["custom/updates", "custom/house", "custom/vpn", "tray", "custom/awake", "group/stats",
                     "backlight", "pulseaudio", "hyprland/language", "network",
                     "battery", "custom/power"],

  "custom/launcher": {
    "format": "",
    "tooltip": false,
    "on-click": "rofi -show drun",
    "on-click-right": "pkill rofi"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    // scratchpads read like deck tags; anything not listed shows its own name
    "format-icons": {
      "discord": "DISCORD", "music": "MUSIC", "term": "TERM", "files": "FILES",
      "special:discord": "DISCORD", "special:music": "MUSIC", "special:term": "TERM", "special:files": "FILES"
    },
    "show-special": true,
    "persistent-workspaces": { "*": 5 },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  "mpris": {
    "format": "<span size='8pt' weight='800' color='#9b5de5'>NOW</span>  {dynamic}",
    "format-paused": "<span size='8pt' weight='800' color='#6c6c8a'>PAUSED</span>  <i>{dynamic}</i>",
    "dynamic-order": ["title", "artist"],
    "dynamic-len": 32,
    "player-icons": { "default": "󰎆", "spotify": "", "firefox": "" },
    "status-icons": { "paused": "" },
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "clock": {
    "format": "<span weight='800'>{:%H:%M}</span>",
    "format-alt": "<span weight='800'>{:%H:%M</span><span weight='800' color='#f15bb5'>:%S}</span>",
    "interval": 1,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "months":   "<span color='#9b5de5'><b>{}</b></span>",
        "weeks":    "<span color='#6c6c8a'>W{}</span>",
        "weekdays": "<span color='#6c6c8a'><b>{}</b></span>",
        "today":    "<span color='#f15bb5'><b><u>{}</u></b></span>"
      }
    }
  },

  // uppercase date tag next to the clock (waybar's clock formatter has no %^a)
  "custom/date": {
    "exec": "LC_TIME=C date +'%^a %d %^b  W%V'",
    "interval": 60,
    "tooltip": false
  },

  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",   // cached + locked; needs pacman-contrib
    "format": "<span size='8pt' weight='800' color='#6c6c8a'>UPD</span>  <span weight='800' color='#f15bb5'>{}</span>",
    "interval": 1800,
    "signal": 8,
    "tooltip": false,
    "on-click": "alacritty -e sh -c '~/.local/bin/neon-update; printf \"\\npress Enter to close \"; read _'"
  },

  // home server health (Marquee's House tab): hidden away from home and until marquee-house is installed
  "custom/house": {
    "exec": "~/.local/bin/marquee-house status",
    "exec-if": "test -x ~/.local/bin/marquee-house",
    "return-type": "json",
    "interval": 300,
    "signal": 9,
    "tooltip": true
  },

  // Mullvad: shield + relay city. neon-vpn.service renders vpn-bar.json and sends RTMIN+15 on every
  // change, so this only reads a file when something happened (no interval, no polling)
  "custom/vpn": {
    "exec": "cat ~/.local/state/neon/vpn-bar.json 2>/dev/null",
    "return-type": "json",
    "signal": 15,
    "tooltip": true,
    "on-click": "~/.local/bin/neon-vpn toggle",
    "on-click-right": "~/.local/bin/neon-vpn relay",
    "on-click-middle": "~/.local/bin/neon-vpn menu"
  },

  "tray": { "icon-size": 15, "spacing": 10 },

  "custom/awake": {
    "exec": "~/.local/bin/screen-awake status",
    "return-type": "json",
    "interval": 2,
    "on-click": "~/.local/bin/screen-awake toggle",
    "exec-on-event": true,
    "tooltip": true
  },

  "group/stats": {
    "orientation": "inherit",
    "modules": ["cpu", "memory"]
  },
  "cpu":    { "interval": 2, "format": "<span size='8pt' weight='800' color='#6c6c8a'>CPU</span>  {usage}%" },
  "memory": {
    "interval": 5,
    "format": "<span size='8pt' weight='800' color='#6c6c8a'>MEM</span>  {used:0.1f}G",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G used"
  },

  "backlight": {
    "format": "<span size='8pt' weight='800' color='#6c6c8a'>BRT</span>  {percent}%",
    "tooltip": false,
    "on-scroll-up": "brightnessctl -q set 5%+",
    "on-scroll-down": "brightnessctl -q --min-value=1% set 5%-"
  },

  "pulseaudio": {
    "format": "<span size='8pt' weight='800' color='#6c6c8a'>VOL</span>  {volume}%",
    "format-muted": "<span size='8pt' weight='800'>VOL</span>  MUTED",
    "format-icons": { "default": ["", "", ""] },
    "scroll-step": 5,
    "tooltip": false,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },

  "hyprland/language": {
    "format": "<span size='8pt' weight='800' color='#6c6c8a'>KB</span>  {}",
    "format-en": "US",
    "format-sv": "SE",
    "keyboard-name": "at-translated-set-2-keyboard"
  },

  "network": {
    "format-wifi": "<span size='8pt' weight='800' color='#6c6c8a'>NET</span>  {essid}",
    "format-ethernet": "<span size='8pt' weight='800' color='#6c6c8a'>NET</span>  WIRED",
    "format-disconnected": "<span size='8pt' weight='800'>NET</span>  OFFLINE",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "max-length": 22
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "<span size='8pt' weight='800' color='#6c6c8a'>BAT</span>  {capacity}%",
    "format-charging": "<span size='8pt' weight='800' color='#9b5de5'>CHG</span>  {capacity}%",
    "format-plugged": "<span size='8pt' weight='800' color='#9b5de5'>AC</span>  {capacity}%",
    "format-alt": "<span size='8pt' weight='800' color='#6c6c8a'>BAT</span>  {time}",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo}  ·  {power:0.1f}W"
  },

  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/power-menu.sh"
  }
}
